# Copy this file to .env and fill in your own values

PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=aven

# Any long random string works
JWT_SECRET=change_this_to_a_long_random_secret

# Optional: only needed when connecting to a cloud MySQL provider that requires
# SSL (e.g. Aiven). Paste the full CA certificate content here. Leave unset for
# local MySQL.
# DB_SSL_CA=
